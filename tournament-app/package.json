{
  "name": "beyfest-tournament-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["engine", "web"],
  "scripts": {
    "test": "bun run --cwd web svelte-kit sync && bun test engine test",
    "e2e": "bun run scripts/e2e.ts",
    "web": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "announcer": "bun --env-file=../.env.local run scripts/announcer.ts",
    "pb": "pb/pocketbase.exe serve --http=0.0.0.0:8090 --dir=pb/pb_data --migrationsDir=pb/pb_migrations"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "pocketbase": "^0.26.2",
    "typescript": "^5.6.0"
  }
}
